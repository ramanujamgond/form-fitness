# Server only. Copy to .env; never put these in web/ or browser settings.
DATABASE_URL=postgresql://USER:PASSWORD@YOUR-NEON-POOLER-HOST/neondb?sslmode=verify-full
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Original owner: only this email may claim pre-account local records.
AUTH_ALLOWED_EMAIL=you@example.com
# Gmail: enable 2-Step Verification and create an App Password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="FORM Fitness <your-app-email@gmail.com>"
