# Server only. Copy to .env; never put these in web/ or browser settings.
DATABASE_URL=postgresql://USER:PASSWORD@YOUR-NEON-POOLER-HOST/neondb?sslmode=verify-full
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Only this email may create an account and access cloud records.
AUTH_ALLOWED_EMAIL=you@example.com
